{
  "name": "fantasy-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e:pages": "VITE_BASE_PATH=/Hagz-fantasy/ VITE_ROUTER_MODE=hash npm run build && playwright test -c playwright.pages.config.ts",
    "test:pages:assets": "VITE_BASE_PATH=/Hagz-fantasy/ VITE_ROUTER_MODE=hash npm run build && VITE_BASE_PATH=/Hagz-fantasy/ node scripts/check-pages-build.mjs",
    "typecheck": "tsc -b",
    "test:db:design": "node --test supabase/design/tests/*.test.mjs",
    "types:db:design": "node supabase/design/generate-types.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^3.9.1",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
